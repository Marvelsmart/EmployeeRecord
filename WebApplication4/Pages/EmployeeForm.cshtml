@page
@model EmployeeFormModel
@{
    ViewData["Title"] = "Employee Record Form";
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Employee Record Form</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
:root{color-scheme:light;--n:#0b2a73;--ln:#dde1e8}
body{background:#fff;color:#111;font-family:Arial,Helvetica,sans-serif;font-size:15px}
.scroll{overflow-x:auto;padding:8px}
.frm{min-width:1100px;max-width:1536px;margin:0 auto;border:1px solid #8f99ae;border-radius:6px;padding:10px 8px 8px}
.co{color:var(--n);font-weight:bold;font-size:25px;letter-spacing:.5px;border-bottom:1px solid var(--n)}
.tag{font:italic bold 14px Arial;color:var(--n);margin:5px 0 0 22px}
h1{color:var(--n);font-size:44px;letter-spacing:-1px;white-space:nowrap;font-weight:bold;margin:0}
.hrb{width:336px;border:2px solid #2b3f78;padding:6px 10px 8px;font-size:16px;font-weight:bold}
.hrb p{margin:4px 0;display:flex;align-items:flex-end;gap:6px}
.hrb span{flex:1;border-bottom:1px solid #333;height:16px}
.nav-tabs{border-bottom:1px solid #6b7488;padding-left:8px;gap:3px}
.nav-tabs .nav-link{height:41px;padding:0 30px;font-size:17px;color:#111;border:1px solid #b5bcc9;border-bottom:0;background:linear-gradient(#f5f6f8,#e2e5ea);border-radius:4px 4px 0 0;cursor:pointer;margin:0}
.nav-tabs .nav-link.active{background:var(--n);color:#fff;font-weight:bold;border-color:var(--n)}
.ban{width:62%;margin:8px auto;background:#fdf3c4;border:1px solid #d0bf6c;text-align:center;font-weight:bold;font-size:18px;padding:4px}
.ban em{color:#d11;font-style:normal}
.sec{background:var(--n);color:#fff;font-weight:bold;font-size:17px;height:31px;line-height:31px;padding-left:14px;white-space:pre}
.c{padding:9px 10px 9px 12px;border-right:1px solid var(--ln);border-bottom:1px solid var(--ln);min-width:0}
.l{display:block;font-weight:bold;font-size:14px;margin-bottom:6px;white-space:nowrap}
.req::before{content:"* ";color:#d11}
.frm .form-control,.frm .form-select{height:27px;padding:0 9px;font-size:15px;border:1px solid #b6bcc8;border-radius:2px;color:#222}
.frm .form-select{padding-right:28px}
.form-check-input{margin:0;width:16px;height:16px}
.form-check-input:checked{background-color:var(--n);border-color:var(--n)}
.ck{display:inline-flex;align-items:center;gap:6px;margin-right:var(--g,16px);cursor:pointer;font-size:14px;font-weight:normal}
.cks{display:flex;align-items:center;flex-wrap:wrap;height:27px}
.in{display:flex;align-items:center;gap:10px}
.in .l{margin:0}
.dt{position:relative}
.dt .btn{position:absolute;right:4px;top:0;height:27px;padding:0 4px;border:0;line-height:0}
.dt input[type=date]{position:absolute;right:7px;bottom:0;width:20px;height:1px;opacity:0;pointer-events:none}
.pcol{border-bottom:1px solid var(--ln);padding:11px 10px}
.photo{height:100%;min-height:190px;border:1.5px solid #5d6b92;background:#fff;text-align:center;cursor:pointer;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center}
.photo b{color:#6b7280;font-size:18px;letter-spacing:.5px;margin-top:10px}
.photo span{color:#6b7280;font-style:italic}
.photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none}
.ul.form-control{border:0;border-bottom:1px solid #333;background:none;border-radius:0;padding:0 4px;box-shadow:none}
.sg{display:flex;align-items:flex-end;gap:12px;font-weight:bold}
.hv{border:1px solid #b3b9c7;padding:6px 12px 6px 14px;font-size:14px}
.hv h5{margin:0 0 4px;text-align:center;font-size:15px;font-weight:bold}
.hv h5 small{font-weight:normal;font-size:13px}
.hv .ck{display:flex;margin:3px 0}
.nt{border-top:1px solid var(--ln);margin-top:6px;padding:7px 10px 2px;font-size:13px}
.nt b,.nt span{color:#c1121f}
.nt span{font-size:15px}
.empty{padding:90px 20px;text-align:center;color:#667;font-size:17px}
</style>
</head>
<body>
<form method="post" enctype="multipart/form-data">
<div class="scroll"><div class="frm">

<div class="d-flex justify-content-between align-items-center px-3 pb-3 pt-1">
  <div class="d-flex align-items-center gap-3" style="width:300px">
    <svg width="64" height="58" viewBox="0 0 64 58" fill="#1c3a8a"><circle cx="32" cy="9" r="8"/><path d="M17 40a15 14 0 0130 0v14H17z"/><circle cx="10" cy="22" r="6"/><circle cx="54" cy="22" r="6"/><path d="M0 46a12 12 0 0112-12h2v18H0zM64 46a12 12 0 00-12-12h-2v18h14z"/></svg>
    <div><div class="co">YOUR COMPANY</div><div class="tag">...Together We Achieve</div></div>
  </div>
  <h1>EMPLOYEE RECORD FORM</h1>
  <div class="hrb"><div class="text-center mb-2">FOR HR USE ONLY</div><p>Employee ID: <span id="empId">-</span></p><p>Date Created: <span id="dateCreated">-</span></p></div>
</div>

<ul class="nav nav-tabs" id="tabs">
  <li class="nav-item"><a class="nav-link active">Personal Information</a></li>
  <li class="nav-item"><a class="nav-link">Employment Information</a></li>
  <li class="nav-item"><a class="nav-link">Payroll Information</a></li>
  <li class="nav-item"><a class="nav-link">Other Information</a></li>
  <li class="nav-item"><a class="nav-link">Next of Kin Information</a></li>
</ul>

<div id="empty" class="empty" hidden></div>

<div id="main">
<div class="ban">Please complete all applicable fields. Fields marked with <em>* are compulsory.</em></div>

<div class="sec">1.   BASIC PERSONAL DETAILS</div>
<div class="row g-0">
  <div class="col-10">
    <div class="row g-0">
      <div class="col-3 c"><label class="l req">First Name:</label><input class="form-control" type="text" name="firstname" required></div>
      <div class="col-3 c"><label class="l">Middle Name:</label><input class="form-control" type="text" name="middlename"></div>
      <div class="col-3 c"><label class="l req">Last Name:</label><input class="form-control" type="text" name="lastname" required></div>
      <div class="col-3 c"><label class="l">Other Name (If any):</label><input class="form-control" type="text" name="othername"></div>
    </div>
    <div class="row g-0">
      <div class="col-2 c"><label class="l req">Gender:</label><div class="cks"><label class="ck"><input class="form-check-input" type="checkbox" data-g="g" name="gender" value="Male">Male</label><label class="ck" style="--g:0"><input class="form-check-input" type="checkbox" data-g="g" name="gender" value="Female">Female</label></div></div>
      <div class="col-3 c"><label class="l req">Date of Birth (DD/MM/YYYY):</label><div class="dt" data-date><input class="form-control" type="text" name="dob" maxlength="10" style="padding-right:34px" required><button type="button" class="btn" aria-label="Pick date"></button><input type="date" tabindex="-1" name="dobDate"></div></div>
      <div class="col-4 c"><label class="l req">Marital Status:</label><div class="cks"><label class="ck" style="--g:12px"><input class="form-check-input" type="checkbox" data-g="m" name="maritalStatus" value="Single">Single</label><label class="ck" style="--g:12px"><input class="form-check-input" type="checkbox" data-g="m" name="maritalStatus" value="Married">Married</label><label class="ck" style="--g:12px"><input class="form-check-input" type="checkbox" data-g="m" name="maritalStatus" value="Divorced">Divorced</label><label class="ck" style="--g:0"><input class="form-check-input" type="checkbox" data-g="m" name="maritalStatus" value="Widowed">Widowed</label></div></div>
      <div class="col-3 c"><label class="l req">Nationality:</label><select class="form-select" data-o="nat" name="nationality" required></select></div>
    </div>
    <div class="row g-0">
      <div class="col-3 c"><label class="l req">State of Origin:</label><select class="form-select" data-o="st" name="stateOfOrigin" required></select></div>
      <div class="col-3 c"><label class="l req">L.G.A.:</label><select class="form-select" data-o="lga" name="lga" required></select></div>
      <div class="col-3 c"><label class="l req">Ethnicity:</label><select class="form-select" data-o="eth" name="ethnicity" required></select></div>
      <div class="col-3 c"><label class="l req">Religion:</label><select class="form-select" data-o="rel" name="religion" required></select></div>
    </div>
  </div>
  <div class="col-2 pcol">
    <div class="photo" id="photo">
      <svg width="86" height="104" viewBox="0 0 96 115" fill="#d3d3d6"><circle cx="48" cy="34" r="32"/><path d="M0 115c0-34 20-50 48-50s48 16 48 50z"/></svg>
      <b>PHOTO</b><span>(Passport Size)</span><img id="pimg" alt="Employee photo">
    </div>
    <input type="file" id="pfile" accept="image/*" hidden name="profilePhoto">
  </div>
</div>
<div class="row g-0">
  <div class="col-3 c"><label class="l req">Phone Number:</label><input class="form-control" type="tel" name="phoneNO" required></div>
  <div class="col-4 c"><label class="l">Alternate Phone Number:</label><input class="form-control" type="tel" name="alternatePhoneNO"></div>
  <div class="col-5 c border-end-0"><label class="l req">Email Address:</label><input class="form-control" type="email" name="email" required></div>
</div>
<div class="row g-0"><div class="col-12 c border-end-0"><label class="l req">Residential Address:</label><input class="form-control" type="text" name="address" required></div></div>
<div class="row g-0">
  <div class="col-4 c"><label class="l req">City/Town:</label><input class="form-control" type="text" name="city" required></div>
  <div class="col-2 c"><label class="l req">State:</label><select class="form-select" data-o="st" name="state" required></select></div>
  <div class="col-3 c"><label class="l req">Country:</label><select class="form-select" data-o="cty" name="country" required></select></div>
  <div class="col-3 c border-end-0"><label class="l req">Postal Code:</label><input class="form-control" type="text" name="postalcode" required></div>
</div>

<div class="sec">2.   IDENTIFICATION DOCUMENTS</div>
<div class="row g-0">
  <div class="col-4 c"><label class="l req">National ID Number:</label><input class="form-control" type="text" name="nationalId" required></div>
  <div class="col-4 c"><label class="l">Driver's License No.:</label><input class="form-control" type="text" name="drivingLicenseNo"></div>
  <div class="col-4 c border-end-0"><label class="l">International Passport No.:</label><input class="form-control" type="text" name="internationalPassportNo"></div>
</div>
<div class="row g-0">
  <div class="col-4 c"><label class="l req">Date of Issue (DD/MM/YYYY):</label><div class="dt" data-date><input class="form-control" type="text" name="dateOfIssue" maxlength="10" style="padding-right:34px" required><button type="button" class="btn" aria-label="Pick date"></button><input type="date" tabindex="-1" name="dateOfIssueDate"></div></div>
  <div class="col-4 c"><label class="l req">Place of Issue:</label><input class="form-control" type="text" name="placeOfIssue" required></div>
  <div class="col-4 c border-end-0"><label class="l req">Expiry Date (DD/MM/YYYY):</label><div class="dt" data-date><input class="form-control" type="text" name="expiryDate" maxlength="10" style="padding-right:34px" required><button type="button" class="btn" aria-label="Pick date"></button><input type="date" tabindex="-1" name="expiryDateDate"></div></div>
</div>

<div class="sec">3.   DEMOGRAPHIC INFORMATION</div>
<div class="row g-0">
  <div class="col-3 c"><div class="in"><label class="l req">Blood Group:</label><select class="form-select" data-o="bg" name="bloodGroup" required></select></div></div>
  <div class="col-3 c"><div class="in"><label class="l req">Genotype:</label><select class="form-select" data-o="gt" name="genotype" required></select></div></div>
  <div class="col-3 c"><div class="in"><label class="l req">Disability (If any):</label><label class="ck" style="--g:6px"><input class="form-check-input" type="checkbox" data-g="d" name="disability" value="Yes">Yes</label><label class="ck" style="--g:0"><input class="form-check-input" type="checkbox" data-g="d" name="disability" value="No">No</label></div></div>
  <div class="col-3 c border-end-0"><div class="in"><label class="l">If Yes, Please Specify:</label><input class="form-control" type="text" name="disabilityType"></div></div>
</div>
<div class="row g-0">
  <div class="col-3 c"><div class="in"><label class="l req">Height (cm):</label><input class="form-control" type="text" inputmode="numeric" name="height" required></div></div>
  <div class="col-3 c"><div class="in"><label class="l req">Weight (kg):</label><input class="form-control" type="text" inputmode="numeric" name="weight" required></div></div>
  <div class="col-3 c"><div class="in"><label class="l req">Complexion:</label><select class="form-select" data-o="cx" name="complexion" required></select></div></div>
  <div class="col-3 c border-end-0"><div class="in"><label class="l req">Hobbies / Interests (If any):</label><input class="form-control" type="text" name="interests"></div></div>
</div>

<div class="row g-4 px-3 pt-3 pb-1">
  <div class="col-8">
    <h4 class="fs-5 fw-semibold mb-2">DECLARATION</h4>
    <p class="mb-4">I hereby declare that the information provided above is true and correct to the best of my knowledge.</p>
    <div class="sg">Employee Signature: <input type="text" class="form-control ul" style="width:300px" name="employeeSignature"> <span class="ms-4">Date (DD/MM/YYYY):</span> <input type="text" class="form-control ul" style="width:200px" maxlength="10" name="signatureDate"></div>
  </div>
  <div class="col-4">
    <div class="hv">
      <h5>HR VERIFICATION <small>(To be completed by HR)</small></h5>
      <label class="ck"><input class="form-check-input" type="checkbox" name="documentsVerified">Documents Verified</label>
      <label class="ck"><input class="form-check-input" type="checkbox" name="informationVerified">Information Verified</label>
      <div class="sg mt-2" style="font-size:12.5px">HR Officer Signature: <input type="text" class="form-control ul" name="hrOfficerSignature"></div>
      <div class="sg mt-2" style="font-size:12.5px">Date: <input type="text" class="form-control ul" style="width:170px" maxlength="10" name="hrDate"></div>
    </div>
  </div>
</div>
<div class="nt d-flex justify-content-between"><div><b>NOTE:</b> Providing false information may lead to disciplinary action, including termination.</div><span>* Compulsory Fields</span></div>

<div class="row g-3 px-3 pt-3 pb-3">
  <div class="col-12">
    <button type="submit" class="btn btn-primary">Submit Form</button>
    <button type="reset" class="btn btn-secondary">Clear Form</button>
  </div>
</div>

</div>
</div>
</form>

<script>
const O={
 nat:["Nigerian","Ghanaian","Beninese","Cameroonian","Nigerien","Chadian","British","American","Canadian","Other"],
 cty:["Nigeria","Ghana","Benin","Cameroon","Niger","Chad","United Kingdom","United States","Canada","Other"],
 st:["Abia","Adamawa","Akwa Ibom","Anambra","Bauchi","Bayelsa","Benue","Borno","Cross River","Delta","Ebonyi","Edo","Ekiti","Enugu","FCT (Abuja)","Gombe","Imo","Jigawa","Kaduna","Kano","Katsina","Kebbi","Kogi","Kwara","Lagos","Nasarawa","Niger","Ogun","Ondo","Osun","Oyo","Plateau","Rivers","Sokoto","Taraba","Yobe","Zamfara"],
 lga:[],
 eth:["Yoruba","Igbo","Hausa","Fulani","Ijaw","Kanuri","Ibibio","Tiv","Edo","Nupe","Other"],
 rel:["Christianity","Islam","Traditional","Other"],
 bg:["A+","A-","B+","B-","AB+","AB-","O+","O-"],
 gt:["AA","AS","SS","AC","SC"],
 cx:["Fair","Light","Medium","Dark"]
};
document.querySelectorAll('select[data-o]').forEach(s=>{s.add(new Option('Select',''));O[s.dataset.o].forEach(v=>s.add(new Option(v,v)))});
document.addEventListener('change',e=>{const t=e.target;if(t.dataset.g&&t.checked)document.querySelectorAll('input[data-g="'+t.dataset.g+'"]').forEach(x=>{if(x!==t)x.checked=false})});
const cal='<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#333" stroke-width="1.4"><rect x="2" y="3" width="16" height="15" rx="1"/><path d="M2 7h16M6 1v4M14 1v4M5 10h2M9 10h2M13 10h2M5 13h2M9 13h2M13 13h2M5 16h2M9 16h2"/></svg>';
document.querySelectorAll('[data-date]').forEach((w, i) => {
 const buttons = w.querySelectorAll('button');
 if (buttons.length > 0) {
   buttons[0].innerHTML = cal;
   const t = w.querySelector('input[type="text"]');
   const d = w.querySelector('input[type="date"]');
   buttons[0].onclick = (e) => {
     e.preventDefault();
     try{d.showPicker()}catch(err){d.focus()}
   };
   d.onchange = () => {
     t.value = d.value.split('-').reverse().join('/');
   };
 }
});
document.querySelectorAll('input[maxlength="10"]').forEach(t=>t.addEventListener('input',()=>{
 if(t.type === 'text') {
   let v=t.value.replace(/\D/g,'').slice(0,8);
   if(v.length>4)v=v.slice(0,2)+'/'+v.slice(2,4)+'/'+v.slice(4);else if(v.length>2)v=v.slice(0,2)+'/'+v.slice(2);
   t.value=v;
 }
}));
const pf=document.getElementById('pfile'),pi=document.getElementById('pimg');
document.getElementById('photo').onclick=()=>pf.click();
pf.onchange=()=>{const f=pf.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{pi.src=r.result;pi.style.display='block'};r.readAsDataURL(f)};
const tabs=[...document.querySelectorAll('.nav-link')],em=document.getElementById('empty'),mn=document.getElementById('main');
tabs.forEach((t,i)=>t.onclick=()=>{tabs.forEach(x=>x.classList.remove('active'));t.classList.add('active');mn.hidden=i>0;em.hidden=i==0;em.textContent=t.textContent+' — not included in the supplied form design.'});
</script>
</body>
</html>
