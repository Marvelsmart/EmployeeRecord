@page
@model EmploymentInformationModel
@{
    ViewData["Title"] = "Employment Information";
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Employment Information - Employee Record Form</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
:root{color-scheme:light
    ;--n:#0b2a73;
    --ln:#dde1e8}
body{background:#fff;
    color:#111;
    font-family:Arial,Helvetica,sans-serif;
    font-size:15px}
.scroll{overflow-x:auto;
    padding:8px}
.frm{min-width:1100px;
    max-width:1536px;
    margin:0 auto;
    border:1px solid #8f99ae;
    border-radius:6px;
    padding:10px 8px 8px}
.co{color:var(--n);
    font-weight:bold;
    font-size:25px;
    letter-spacing:.5px;
    border-bottom:1px solid var(--n)}
.tag{font:italic bold 14px Arial;
    color:var(--n);
    margin:5px 0 0 22px}
h1{color:var(--n);
    font-size:44px;
    letter-spacing:-1px;
    white-space:nowrap;
    font-weight:bold;
    margin:0}
.hrb{width:336px;
    border:2px solid #2b3f78;
    padding:6px 10px 8px;
    font-size:16px;
    font-weight:bold}
.hrb p{margin:4px 0;
    display:flex;
    align-items:flex-end;
    gap:6px}
.hrb span{flex:1;
    border-bottom:1px solid #333;
    height:16px}
.nav-tabs{border-bottom:1px solid #6b7488;
    padding-left:8px;
    gap:3px}
.nav-tabs .nav-link{height:41px;padding:0 30px;
    font-size:17px;color:#111;
    border:1px solid #b5bcc9;
    border-bottom:0;
    background:linear-gradient(#f5f6f8,#e2e5ea);
    border-radius:4px 4px 0 0;
    cursor:pointer;
    margin:0;
    text-decoration:none}
.nav-tabs .nav-link.active{background:var(--n);
    color:#fff;
    font-weight:bold;
    border-color:var(--n)}
.nav-tabs .nav-link:hover{color:#333}
.ban{width:62%;
    margin:8px auto;
    background:#fdf3c4;
    border:1px solid #d0bf6c;
    text-align:center;
    font-weight:bold;
    font-size:18px;
    padding:4px}
.ban em{color:#d11;
    font-style:normal}
.sec{background:var(--n);
    color:#fff;
    font-weight:bold;
    font-size:17px;
    height:31px;
    line-height:31px;
    padding-left:14px;
    white-space:pre}
.c{padding:9px 10px 9px 12px;
    border-right:1px solid var(--ln);
    border-bottom:1px solid var(--ln);
    min-width:0}
.l{display:block;
    font-weight:bold;
    font-size:14px;margin-bottom:6px;
    white-space:nowrap}
.req::before{content:"* ";
    color:#d11}
.frm .form-control,.frm .form-select{height:27px;
    padding:0 9px;
    font-size:15px;
    border:1px solid #b6bcc8;
    border-radius:2px;
    color:#222}

.frm .form-select{padding-right:28px}

.form-check-input{margin:0;width:16px;
    height:16px}
.form-check-input:checked{background-color:var(--n);
    border-color:var(--n)}
.ck{display:inline-flex;
    align-items:center;
    gap:6px;
    margin-right:var(--g,16px);
    cursor:pointer;
    font-size:14px;
    font-weight:normal}

.cks{display:flex;
    align-items:center;
    flex-wrap:wrap;
    height:27px}

.in{display:flex;
    align-items:center;
    gap:10px}

.in .l{margin:0}

.dt{position:relative}

.dt .btn{position:absolute;
    right:4px;
    top:0;
    height:27px;
    padding:0 4px;
    border:0;
    line-height:0}

.dt input[type=date]{position:absolute;
    right:7px;
    bottom:0;
    width:20px;
    height:1px;
    opacity:0;
    pointer-events:none}

.ul.form-control{border:0;
    border-bottom:1px solid #333;
    background:none;
    border-radius:0;
    padding:0 4px;
    box-shadow:none}

.sg{display:flex;
    align-items:flex-end;
    gap:12px;
    font-weight:bold}

.hv{border:1px solid #b3b9c7;
    padding:6px 12px 6px 14px;
    font-size:14px}

.hv h5{margin:0 0 4px;
    text-align:center;
    font-size:15px;
    font-weight:bold}

.hv h5 small{font-weight:normal;
    font-size:13px}

.hv .ck{display:flex;
    margin:3px 0}
.nt{border-top:1px solid var(--ln);margin-top:6px;padding:7px 10px 2px;font-size:13px}
.nt b,.nt span{color:#c1121f}
.nt span{font-size:15px}
.nav-buttons{display:flex;gap:10px;justify-content:flex-end;margin-top:20px;padding:0 20px 20px}
.nav-buttons a,.nav-buttons button{padding:8px 20px;border-radius:4px;border:1px solid #b5bcc9;background:linear-gradient(#f5f6f8,#e2e5ea);color:#111;text-decoration:none;cursor:pointer;font-weight:bold}
.nav-buttons a:hover,.nav-buttons button:hover{background:linear-gradient(#e2e5ea,#d5d8de)}
.nav-buttons a.next{background:var(--n);color:#fff;border-color:var(--n)}
.nav-buttons a.next:hover{background:#082058}
</style>
</head>
<body>
<div class="scroll"><div class="frm">

<div class="d-flex justify-content-between align-items-center px-3 pb-3 pt-1">
  <div class="d-flex align-items-center gap-3" style="width:300px">
    <svg width="64" height="58" viewBox="0 0 64 58" fill="#1c3a8a"><circle cx="32" cy="9" r="8"/><path d="M17 40a15 14 0 0130 0v14H17z"/><circle cx="10" cy="22" r="6"/><circle cx="54" cy="22" r="6"/><path d="M0 46a12 12 0 0112-12h2v18H0zM64 46a12 12 0 00-12-12h-2v18h14z"/></svg>
    <div><div class="co">YOUR COMPANY</div><div class="tag">...Together We Achieve</div></div>
  </div>
  <h1>EMPLOYEE RECORD FORM</h1>
  <div class="hrb"><div class="text-center mb-2">FOR HR USE ONLY</div><p>Employee ID: <span></span></p><p>Date Created: <span></span></p></div>
</div>

<ul class="nav nav-tabs" id="tabs">
  <li class="nav-item"><a class="nav-link" href="/PersonalInformation">Personal Information</a></li>
  <li class="nav-item"><a class="nav-link active">Employment Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/PayrollInformation">Payroll Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/OtherInformation">Other Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/NextOfKinInformation">Next of Kin Information</a></li>
</ul>

<div style="padding:40px;text-align:center;">
  <div style="font-size:24px;font-weight:bold;color:var(--n);margin-bottom:20px;">Employment Information</div>
  <div style="font-size:18px;color:#666;">No form for this tab</div>
</div>

<div class="nav-buttons">
  <a href="/PersonalInformation" class="prev">← Previous</a>
  <a href="/PayrollInformation" class="next">Next →</a>
</div>

</div></div>

<script>
const O={
 emptype:["Permanent","Contract","Part-Time","Temporary","Internship"],
 empstatus:["Active","On Leave","Suspended","Terminated"],
 contract:["Indefinite","Fixed Term","Project-Based"],
 visa:["Residency Visa","Work Visa","Visitor Visa","Other"]
};

document.querySelectorAll('select[data-o]').forEach(s=>{
  s.add(new Option('Select',''));
  O[s.dataset.o].forEach(v=>s.add(new Option(v,v)))
});

document.addEventListener('change',e=>{
  const t=e.target;
  if(t.dataset.g&&t.checked)
    document.querySelectorAll('input[data-g="'+t.dataset.g+'"]').forEach(x=>{
      if(x!==t)x.checked=false
    })
});

const cal='<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#333" stroke-width="1.4"><rect x="2" y="3" width="16" height="15" rx="1"/><path d="M2 7h16M6 1v4M14 1v4M5 10h2M9 10h2M13 10h2M5 13h2M9 13h2M13 13h2M5 16h2M9 16h2"/></svg>';
document.querySelectorAll('[data-date]').forEach(w=>{
 w.innerHTML='<input class="form-control" type="text" maxlength="10" style="padding-right:34px" required><button type="button" class="btn" aria-label="Pick date">'+cal+'</button><input type="date" tabindex="-1">';
 const t=w.children[0],d=w.children[2];
 w.children[1].onclick=()=>{try{d.showPicker()}catch(e){d.focus()}};
 d.onchange=()=>{t.value=d.value.split('-').reverse().join('/')};
});

document.querySelectorAll('input[maxlength="10"]').forEach(t=>t.addEventListener('input',()=>{
 let v=t.value.replace(/\D/g,'').slice(0,8);
 if(v.length>4)v=v.slice(0,2)+'/'+v.slice(2,4)+'/'+v.slice(4);else if(v.length>2)v=v.slice(0,2)+'/'+v.slice(2);
 t.value=v;
}));
</script>
</body>
</html>
