@page
@model PersonalInformationModel
@{
    ViewData["Title"] = "Personal Information";
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Personal Information - Employee Record Form</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/personal-information.css" />
</head>

<body>

<div class="scroll"><div class="frm">

<div class="d-flex justify-content-between align-items-center px-3 pb-3 pt-1">
  <div class="d-flex align-items-center gap-3 page-header-brand">
    <svg width="64" height="58" viewBox="0 0 64 58" fill="#1c3a8a"><circle cx="32" cy="9" r="8"/><path d="M17 40a15 14 0 0130 0v14H17z"/><circle cx="10" cy="22" r="6"/><circle cx="54" cy="22" r="6"/><path d="M0 46a12 12 0 0112-12h2v18H0zM64 46a12 12 0 00-12-12h-2v18h14z"/></svg>
    <div><div class="co">YOUR COMPANY</div><div class="tag">...Together We Achieve</div></div>
  </div>
  <h1>EMPLOYEE RECORD FORM</h1>
  <div class="hrb"><div class="text-center mb-2">FOR HR USE ONLY</div><p>Employee ID: <span></span></p><p>Date Created: <span></span></p></div>
</div>

<ul class="nav nav-tabs" id="tabs">
  <li class="nav-item"><a class="nav-link active">Personal Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/EmploymentInformation">Employment Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/PayrollInformation">Payroll Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/OtherInformation">Other Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/NextOfKinInformation">Next of Kin Information</a></li>
</ul>

<form method="POST">

<div class="ban">Please complete all applicable fields. Fields marked with <em>* are compulsory.</em></div>

<div class="sec">1.   BASIC PERSONAL DETAILS</div>
<div class="row g-0">
  <div class="col-10">
    <div class="row g-0">
      <div class="col-3 c"><label class="l req">First Name:</label><input class="form-control" type="text" name="firstName" required></div>
      <div class="col-3 c"><label class="l">Middle Name:</label><input class="form-control" type="text" name="middleName"></div>
      <div class="col-3 c"><label class="l req">Last Name:</label><input class="form-control" type="text" name="lastName" required></div>
      <div class="col-3 c"><label class="l">Other Name (If any):</label><input class="form-control" type="text" name="otherName"></div>
    </div>
    <div class="row g-0">
      <div class="col-2 c"><label class="l req">Gender:</label><div class="cks"><label class="ck"><input type="radio" name="gender" value="Male" required>Male</label><label class="ck compact"><input type="radio" name="gender" value="Female" required>Female</label></div></div>
      <div class="col-3 c"><label class="l req">Date of Birth (DD/MM/YYYY):</label><input class="form-control" type="text" name="dateOfBirth" maxlength="10" required></div>
      <div class="col-4 c"><label class="l req">Marital Status:</label><select class="form-select" name="martialStatus" required><option value="">Select</option><option value="Single">Single</option><option value="Married">Married</option><option value="Divorced">Divorced</option><option value="Widowed">Widowed</option></select></div>
      <div class="col-3 c"><label class="l req">Nationality:</label><input class="form-control" type="text" name="nationality" required></div>
    </div>
    <div class="row g-0">
      <div class="col-3 c"><label class="l req">State of Origin:</label><input class="form-control" type="text" name="stateOfOrigin" required></div>
      <div class="col-3 c"><label class="l req">L.G.A.:</label><input class="form-control" type="text" name="lga" required></div>
      <div class="col-3 c"><label class="l req">Ethnicity:</label><input class="form-control" type="text" name="ethnicity" required></div>
      <div class="col-3 c"><label class="l req">Religion:</label><input class="form-control" type="text" name="religion" required></div>
    </div>
  </div>
  <div class="col-2 pcol">
    <div class="photo" id="photo">
      <svg width="86" height="104" viewBox="0 0 96 115" fill="#d3d3d6"><circle cx="48" cy="34" r="32"/><path d="M0 115c0-34 20-50 48-50s48 16 48 50z"/></svg>
      <b>PHOTO</b><span>(Passport Size)</span><img id="pimg" alt="Employee photo">
    </div>
    <input type="file" id="pfile" name="photoFile" accept="image/*" hidden>
  </div>
</div>
<div class="row g-0">
  <div class="col-3 c"><label class="l req">Phone Number:</label><input class="form-control" type="tel" name="phoneNumber" required></div>
  <div class="col-4 c"><label class="l">Alternate Phone Number:</label><input class="form-control" type="tel" name="alternatePhone"></div>
  <div class="col-5 c border-end-0"><label class="l req">Email Address:</label><input class="form-control" type="email" name="emailAddress" required></div>
</div>
<div class="row g-0"><div class="col-12 c border-end-0"><label class="l req">Residential Address:</label><input class="form-control" type="text" name="residentialAddress" required></div></div>
<div class="row g-0">
  <div class="col-4 c"><label class="l req">City/Town:</label><input class="form-control" type="text" name="cityTown" required></div>
  <div class="col-2 c"><label class="l req">State:</label><input class="form-control" type="text" name="state" required></div>
  <div class="col-3 c"><label class="l req">Country:</label><input class="form-control" type="text" name="country" required></div>
  <div class="col-3 c border-end-0"><label class="l req">Postal Code:</label><input class="form-control" type="text" name="postalCode" required></div>
</div>

<div class="sec">2.   IDENTIFICATION DOCUMENTS</div>
<div class="row g-0">
  <div class="col-3 c"><label class="l">National ID Number:</label><input class="form-control" type="text" name="nationalID"></div>
  <div class="col-3 c"><label class="l">Driver's License:</label><input class="form-control" type="text" name="driversLicense"></div>
  <div class="col-3 c"><label class="l">Passport Number:</label><input class="form-control" type="text" name="passport"></div>
  <div class="col-3 c border-end-0"><label class="l">Passport Expiry Date (DD/MM/YYYY):</label><input class="form-control" type="text" name="expiryDate" maxlength="10"></div>
</div>
<div class="row g-0">
  <div class="col-4 c"><label class="l">Date of Issue (DD/MM/YYYY):</label><input class="form-control" type="text" name="dateOfIssue" maxlength="10"></div>
  <div class="col-8 c border-end-0"><label class="l">Place of Issue:</label><input class="form-control" type="text" name="placeOfIssue"></div>
</div>

<div class="sec">3.   DEMOGRAPHIC INFORMATION</div>
<div class="row g-0">
  <div class="col-3 c"><label class="l">Blood Group:</label><select class="form-select" name="bloodGroup"><option value="">Select</option><option value="A+">A+</option><option value="A-">A-</option><option value="B+">B+</option><option value="B-">B-</option><option value="AB+">AB+</option><option value="AB-">AB-</option><option value="O+">O+</option><option value="O-">O-</option></select></div>
  <div class="col-3 c"><label class="l">Genotype:</label><select class="form-select" name="genotype"><option value="">Select</option><option value="AA">AA</option><option value="AS">AS</option><option value="SS">SS</option><option value="AC">AC</option><option value="SC">SC</option></select></div>
  <div class="col-3 c"><label class="l">Has Disability?</label><div class="cks"><label class="ck"><input type="radio" name="hasDisability" value="Yes">Yes</label><label class="ck compact"><input type="radio" name="hasDisability" value="No">No</label></div></div>
  <div class="col-3 c border-end-0"><label class="l">Disability Details (if any):</label><input class="form-control" type="text" name="disabilityDetails"></div>
</div>
<div class="row g-0">
  <div class="col-4 c"><label class="l">Height (cm):</label><input class="form-control" type="number" name="height"></div>
  <div class="col-4 c"><label class="l">Weight (kg):</label><input class="form-control" type="number" name="weight"></div>
  <div class="col-4 c border-end-0"><label class="l">Complexion:</label><select class="form-select" name="complexion"><option value="">Select</option><option value="Fair">Fair</option><option value="Light">Light</option><option value="Medium">Medium</option><option value="Dark">Dark</option></select></div>
</div>
<div class="row g-0"><div class="col-12 c border-end-0"><label class="l">Hobbies & Interests:</label><input class="form-control" type="text" name="hobbies"></div></div>

<div class="row g-4 px-3 pt-3 pb-1">
  <div class="col-8">
    <h4 class="fs-5 fw-semibold mb-2">DECLARATION</h4>
    <p class="mb-4">I hereby declare that the information provided above is true and correct to the best of my knowledge.</p>
    <div class="sg">Employee Signature: <input type="text" name="employeeSignature" class="form-control ul signature-input"> <span class="ms-4">Date (DD/MM/YYYY):</span> <input type="text" name="declarationDate" class="form-control ul declaration-date-input" maxlength="10"></div>
  </div>
  <div class="col-4">
    <div class="hv">
      <h5>HR VERIFICATION <small>(To be completed by HR)</small></h5>
      <label class="ck"><input class="form-check-input" type="checkbox" name="docsVerified">Documents Verified</label>
      <label class="ck"><input class="form-check-input" type="checkbox" name="infoVerified">Information Verified</label>
      <div class="sg mt-2 hr-signature-row">HR Officer Signature: <input type="text" name="hrSignature" class="form-control ul"></div>
      <div class="sg mt-2 hr-date-row">Date: <input type="text" name="hrDate" class="form-control ul hr-date-input" maxlength="10"></div>
    </div>
  </div>
</div>

<div class="nav-buttons">
  <a href="/" class="btn btn-secondary">Back to Dashboard</a>
  <button type="submit" class="btn btn-success submit">Submit</button>
</div>

</form>
</div></div>
</body>

<script>
// Format date inputs (DD/MM/YYYY)
document.querySelectorAll('input[maxlength="10"]').forEach(dateInput => {
  dateInput.addEventListener('input', function() {
    let value = this.value.replace(/\D/g, '').slice(0, 8);

    if (value.length > 4) {
      value = value.slice(0, 2) + '/' + value.slice(2, 4) + '/' + value.slice(4);
    } else if (value.length > 2) {
      value = value.slice(0, 2) + '/' + value.slice(2);
    }

    this.value = value;
  });
});

// Handle photo upload
const photoInput = document.getElementById('pfile');
const photoImage = document.getElementById('pimg');
const photoBox = document.getElementById('photo');

photoBox.addEventListener('click', function() {
  photoInput.click();
});

photoInput.addEventListener('change', function() {
  const file = this.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.addEventListener('load', function() {
    photoImage.src = this.result;
    photoImage.style.display = 'block';
  });
  reader.readAsDataURL(file);
});
</script>

</html>
