@page "{id:int}"
@model EditEmployeeModel
@{
    ViewData["Title"] = "Edit Employee";
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Edit Employee - Employee Record Form</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/edit-employee.css" />
</head>
<body>
<div class="scroll"><div class="frm">

<div class="d-flex justify-content-between align-items-center px-3 pb-3 pt-1">
  <div class="d-flex align-items-center gap-3 page-header-brand">
    <svg width="64" height="58" viewBox="0 0 64 58" fill="#1c3a8a"><circle cx="32" cy="9" r="8"/><path d="M17 40a15 14 0 0130 0v14H17z"/><circle cx="10" cy="22" r="6"/><circle cx="54" cy="22" r="6"/><path d="M0 46a12 12 0 0112-12h2v18H0zM64 46a12 12 0 00-12-12h-2v18h14z"/></svg>
    <div><div class="co">YOUR COMPANY</div><div class="tag">...Together We Achieve</div></div>
  </div>
  <h1>EDIT EMPLOYEE RECORD</h1>
</div>

@if (Model.Employee != null)
{
    <form method="POST">
        <input type="hidden" name="id" value="@Model.Employee.Id">

        <div class="sec">1.   BASIC PERSONAL DETAILS</div>
        <div class="row g-0">
            <div class="col-3 c"><label class="l req">First Name:</label><input class="form-control" type="text" name="firstName" value="@Model.Employee.Firstname" required></div>
            <div class="col-3 c"><label class="l">Middle Name:</label><input class="form-control" type="text" name="middleName" value="@(Model.Employee.Middlename ?? "")"></div>
            <div class="col-3 c"><label class="l req">Last Name:</label><input class="form-control" type="text" name="lastName" value="@Model.Employee.Lastname" required></div>
            <div class="col-3 c"><label class="l">Other Name:</label><input class="form-control" type="text" name="otherName" value="@(Model.Employee.Othername ?? "")"></div>
        </div>
        <div class="row g-0">
            <div class="col-2 c"><label class="l req">Gender:</label><div class="cks"><label class="ck"><input type="radio" name="gender" value="Male" @(Model.Employee.GenderType == EmployeeRecord.Models.Enums.GenderType.Male ? "checked" : "") required> Male</label><label class="ck compact"><input type="radio" name="gender" value="Female" @(Model.Employee.GenderType == EmployeeRecord.Models.Enums.GenderType.Female ? "checked" : "") required> Female</label></div></div>
            <div class="col-3 c"><label class="l req">Date of Birth:</label><input class="form-control" type="text" name="dateOfBirth" value="@Model.Employee.Dateofbirth.ToString("dd/MM/yyyy")" maxlength="10" required></div>
            <div class="col-4 c"><label class="l req">Marital Status:</label>
            @{
                var selectedStatus = Model.Employee.MaritalStatusType.ToString();
            }
            <select class="form-select" name="martialStatus" required>
                <option>Select</option>
                @if(selectedStatus == "Single")
                {
                    <option value="Single" selected>Single</option>
                }
                else
                {
                    <option value="Single">Single</option>
                }
                @if(selectedStatus == "Married")
                {
                    <option value="Married" selected>Married</option>
                }
                else
                {
                    <option value="Married">Married</option>
                }
                @if(selectedStatus == "Divorced")
                {
                    <option value="Divorced" selected>Divorced</option>
                }
                else
                {
                    <option value="Divorced">Divorced</option>
                }
                @if(selectedStatus == "Widowed")
                {
                    <option value="Widowed" selected>Widowed</option>
                }
                else
                {
                    <option value="Widowed">Widowed</option>
                }
            </select>
            </div>
            <div class="col-3 c"><label class="l req">Nationality:</label><input class="form-control" type="text" name="nationality" value="@Model.Employee.Nationality" required></div>
        </div>
        <div class="row g-0">
            <div class="col-3 c"><label class="l req">State of Origin:</label><input class="form-control" type="text" name="stateOfOrigin" value="@Model.Employee.StateOfOrigin" required></div>
            <div class="col-3 c"><label class="l req">L.G.A.:</label><input class="form-control" type="text" name="lga" value="@Model.Employee.LGA" required></div>
            <div class="col-3 c"><label class="l req">Ethnicity:</label><input class="form-control" type="text" name="ethnicity" value="@Model.Employee.Ethnicity" required></div>
            <div class="col-3 c border-end-0"><label class="l req">Religion:</label><input class="form-control" type="text" name="religion" value="@Model.Employee.Religion" required></div>
        </div>
        <div class="row g-0">
            <div class="col-3 c"><label class="l req">Phone Number:</label><input class="form-control" type="tel" name="phoneNumber" value="@Model.Employee.PhoneNO" required></div>
            <div class="col-4 c"><label class="l">Alternate Phone:</label><input class="form-control" type="tel" name="alternatePhone" value="@(Model.Employee.AlternatePhoneNO ?? "")"></div>
            <div class="col-5 c border-end-0"><label class="l req">Email Address:</label><input class="form-control" type="email" name="emailAddress" value="@Model.Employee.Email" required></div>
        </div>
        <div class="row g-0"><div class="col-12 c border-end-0"><label class="l req">Residential Address:</label><input class="form-control" type="text" name="residentialAddress" value="@Model.Employee.Address" required></div></div>
        <div class="row g-0">
            <div class="col-4 c"><label class="l req">City/Town:</label><input class="form-control" type="text" name="cityTown" value="@Model.Employee.City" required></div>
            <div class="col-2 c"><label class="l req">State:</label><input class="form-control" type="text" name="state" value="@Model.Employee.State" required></div>
            <div class="col-3 c"><label class="l req">Country:</label><input class="form-control" type="text" name="country" value="@Model.Employee.Country" required></div>
            <div class="col-3 c border-end-0"><label class="l req">Postal Code:</label><input class="form-control" type="text" name="postalCode" value="@Model.Employee.Postalcode" required></div>
        </div>

        <div class="sec">2.   IDENTIFICATION DOCUMENTS</div>
        <div class="row g-0">
            <div class="col-3 c"><label class="l">National ID Number:</label><input class="form-control" type="text" name="nationalID" value="@(Model.Employee.NationalID ?? "")"></div>
            <div class="col-3 c"><label class="l">Driver's License:</label><input class="form-control" type="text" name="driversLicense" value="@(Model.Employee.DriversLicense ?? "")"></div>
            <div class="col-3 c"><label class="l">Passport Number:</label><input class="form-control" type="text" name="passport" value="@(Model.Employee.Passport ?? "")"></div>
            <div class="col-3 c border-end-0"><label class="l">Passport Expiry Date (DD/MM/YYYY):</label><input class="form-control" type="text" name="expiryDate" value="@(Model.Employee.ExpiryDate.HasValue ? Model.Employee.ExpiryDate.Value.ToString("dd/MM/yyyy") : "")" maxlength="10"></div>
        </div>
        <div class="row g-0">
            <div class="col-4 c"><label class="l">Date of Issue (DD/MM/YYYY):</label><input class="form-control" type="text" name="dateOfIssue" value="@(Model.Employee.DateofIssue.HasValue ? Model.Employee.DateofIssue.Value.ToString("dd/MM/yyyy") : "")" maxlength="10"></div>
            <div class="col-8 c border-end-0"><label class="l">Place of Issue:</label><input class="form-control" type="text" name="placeOfIssue" value="@(Model.Employee.PlaceofIssue ?? "")"></div>
        </div>

        <div class="sec">3.   DEMOGRAPHIC INFORMATION</div>
        <div class="row g-0">
            <div class="col-3 c"><label class="l">Blood Group:</label>
            @{
                var bloodGroup = Model.Employee.BloodGroup ?? "";
            }
            <select class="form-select" name="bloodGroup">
                <option value="">Select</option>
                @if(bloodGroup == "A+") { <option value="A+" selected>A+</option> } else { <option value="A+">A+</option> }
                @if(bloodGroup == "A-") { <option value="A-" selected>A-</option> } else { <option value="A-">A-</option> }
                @if(bloodGroup == "B+") { <option value="B+" selected>B+</option> } else { <option value="B+">B+</option> }
                @if(bloodGroup == "B-") { <option value="B-" selected>B-</option> } else { <option value="B-">B-</option> }
                @if(bloodGroup == "AB+") { <option value="AB+" selected>AB+</option> } else { <option value="AB+">AB+</option> }
                @if(bloodGroup == "AB-") { <option value="AB-" selected>AB-</option> } else { <option value="AB-">AB-</option> }
                @if(bloodGroup == "O+") { <option value="O+" selected>O+</option> } else { <option value="O+">O+</option> }
                @if(bloodGroup == "O-") { <option value="O-" selected>O-</option> } else { <option value="O-">O-</option> }
            </select></div>
            <div class="col-3 c"><label class="l">Genotype:</label>
            @{
                var genotype = Model.Employee.Genotype ?? "";
            }
            <select class="form-select" name="genotype">
                <option value="">Select</option>
                @if(genotype == "AA") { <option value="AA" selected>AA</option> } else { <option value="AA">AA</option> }
                @if(genotype == "AS") { <option value="AS" selected>AS</option> } else { <option value="AS">AS</option> }
                @if(genotype == "SS") { <option value="SS" selected>SS</option> } else { <option value="SS">SS</option> }
                @if(genotype == "AC") { <option value="AC" selected>AC</option> } else { <option value="AC">AC</option> }
                @if(genotype == "SC") { <option value="SC" selected>SC</option> } else { <option value="SC">SC</option> }
            </select></div>
            <div class="col-3 c"><label class="l">Has Disability?</label><div class="cks"><label class="ck"><input type="radio" name="hasDisability" value="Yes" @(Model.Employee.HasDisability == "Yes" ? "checked" : "")>Yes</label><label class="ck compact"><input type="radio" name="hasDisability" value="No" @(Model.Employee.HasDisability == "No" ? "checked" : "")>No</label></div></div>
            <div class="col-3 c border-end-0"><label class="l">Disability Details (if any):</label><input class="form-control" type="text" name="disabilityDetails" value="@(Model.Employee.DisabilityDetails ?? "")"></div>
        </div>
        <div class="row g-0">
            <div class="col-4 c"><label class="l">Height (cm):</label><input class="form-control" type="number" name="height" value="@(Model.Employee.Height ?? 0)"></div>
            <div class="col-4 c"><label class="l">Weight (kg):</label><input class="form-control" type="number" name="weight" value="@(Model.Employee.Weight ?? 0)"></div>
            <div class="col-4 c border-end-0"><label class="l">Complexion:</label>
            @{
                var complexion = Model.Employee.Complexion ?? "";
            }
            <select class="form-select" name="complexion">
                <option value="">Select</option>
                @if(complexion == "Fair") { <option value="Fair" selected>Fair</option> } else { <option value="Fair">Fair</option> }
                @if(complexion == "Light") { <option value="Light" selected>Light</option> } else { <option value="Light">Light</option> }
                @if(complexion == "Medium") { <option value="Medium" selected>Medium</option> } else { <option value="Medium">Medium</option> }
                @if(complexion == "Dark") { <option value="Dark" selected>Dark</option> } else { <option value="Dark">Dark</option> }
            </select></div>
        </div>
        <div class="row g-0"><div class="col-12 c border-end-0"><label class="l">Hobbies & Interests:</label><input class="form-control" type="text" name="hobbies" value="@(Model.Employee.Hobbies ?? "")"></div></div>

        <div class="nav-buttons">
            <a href="/EmployeeReview" class="nav-link">← Back to Records</a>
            <button type="submit" class="save">Save Changes ✓</button>
        </div>
    </form>
}
else
{
    <div class="not-found">
        <div class="not-found-message">Employee record not found.</div>
        <a href="/EmployeeReview" class="back-link">Back to Records</a>
    </div>
}

</div></div>

<script>
document.querySelectorAll('input[maxlength="10"]').forEach(t=>t.addEventListener('input',()=>{
 let v=t.value.replace(/\D/g,'').slice(0,8);
 if(v.length>4)v=v.slice(0,2)+'/'+v.slice(2,4)+'/'+v.slice(4);else if(v.length>2)v=v.slice(0,2)+'/'+v.slice(2);
 t.value=v;
}));
</script>
</body>
</html>
