@page
@model NextOfKinInformationModel
@{
    ViewData["Title"] = "Next of Kin Information";
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Next of Kin Information - Employee Record Form</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/next-of-kin-information.css" />
</head>
<body>
<div class="scroll"><div class="frm">

<div class="d-flex justify-content-between align-items-center px-3 pb-3 pt-1">
  <div class="d-flex align-items-center gap-3 page-header-brand">
    <svg width="64" height="58" viewBox="0 0 64 58" fill="#1c3a8a"><circle cx="32" cy="9" r="8"/><path d="M17 40a15 14 0 0130 0v14H17z"/><circle cx="10" cy="22" r="6"/><circle cx="54" cy="22" r="6"/><path d="M0 46a12 12 0 0112-12h2v18H0zM64 46a12 12 0 00-12-12h-2v18h14z"/></svg>
    <div><div class="co">YOUR COMPANY</div><div class="tag">...Together We Achieve</div></div>
  </div>
  <h1>EMPLOYEE RECORD FORM</h1>
  <div class="hrb"><div class="text-center mb-2">FOR HR USE ONLY</div><p>Employee ID: <span></span></p><p>Date Created: <span></span></p></div>
</div>

<ul class="nav nav-tabs" id="tabs">
  <li class="nav-item"><a class="nav-link" href="/PersonalInformation">Personal Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/EmploymentInformation">Employment Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/PayrollInformation">Payroll Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/OtherInformation">Other Information</a></li>
  <li class="nav-item"><a class="nav-link active">Next of Kin Information</a></li>
</ul>

<div class="not-found">
  <div class="not-found-title">Next of Kin Information</div>
  <div class="not-found-message">No form for this tab</div>
</div>

<div class="nav-buttons">
  <a href="/OtherInformation" class="prev">← Previous</a>
  <a href="/EmployeeReview" class="next">View Records →</a>
</div>

</div></div>

<script>
const O={
 kinrel:["Spouse","Parent","Child","Sibling","Extended Family","Other"],
 deprel:["Son","Daughter","Stepson","Stepdaughter","Adopted Child","Other"]
};

document.querySelectorAll('select[data-o]').forEach(s=>{
  s.add(new Option('Select',''));
  O[s.dataset.o].forEach(v=>s.add(new Option(v,v)))
});

document.addEventListener('change',e=>{
  const t=e.target;
  if(t.dataset.g&&t.checked)
    document.querySelectorAll('input[data-g="'+t.dataset.g+'"]').forEach(x=>{
      if(x!==t)x.checked=false
    })
});

const cal='<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#333" stroke-width="1.4"><rect x="2" y="3" width="16" height="15" rx="1"/><path d="M2 7h16M6 1v4M14 1v4M5 10h2M9 10h2M13 10h2M5 13h2M9 13h2M13 13h2M5 16h2M9 16h2"/></svg>';
document.querySelectorAll('[data-date]').forEach(w=>{
 w.innerHTML='<input class="form-control date-input" type="text" maxlength="10"><button type="button" class="btn" aria-label="Pick date">'+cal+'</button><input type="date" tabindex="-1">';
 const t=w.children[0],d=w.children[2];
 w.children[1].onclick=()=>{try{d.showPicker()}catch(e){d.focus()}};
 d.onchange=()=>{t.value=d.value.split('-').reverse().join('/')};
});

document.querySelectorAll('input[maxlength="10"]').forEach(t=>t.addEventListener('input',()=>{
 let v=t.value.replace(/\D/g,'').slice(0,8);
 if(v.length>4)v=v.slice(0,2)+'/'+v.slice(2,4)+'/'+v.slice(4);else if(v.length>2)v=v.slice(0,2)+'/'+v.slice(2);
 t.value=v;
}));
</script>
</body>
</html>
