@page
@model OtherInformationModel
@{
    ViewData["Title"] = "Other Information";
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Other Information - Employee Record Form</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/other-information.css" />
</head>
<body>
<div class="scroll"><div class="frm">

<div class="d-flex justify-content-between align-items-center px-3 pb-3 pt-1">
  <div class="d-flex align-items-center gap-3 page-header-brand">
    <svg width="64" height="58" viewBox="0 0 64 58" fill="#1c3a8a"><circle cx="32" cy="9" r="8"/><path d="M17 40a15 14 0 0130 0v14H17z"/><circle cx="10" cy="22" r="6"/><circle cx="54" cy="22" r="6"/><path d="M0 46a12 12 0 0112-12h2v18H0zM64 46a12 12 0 00-12-12h-2v18h14z"/></svg>
    <div><div class="co">YOUR COMPANY</div><div class="tag">...Together We Achieve</div></div>
  </div>
  <h1>EMPLOYEE RECORD FORM</h1>
  <div class="hrb"><div class="text-center mb-2">FOR HR USE ONLY</div><p>Employee ID: <span></span></p><p>Date Created: <span></span></p></div>
</div>

<ul class="nav nav-tabs" id="tabs">
  <li class="nav-item"><a class="nav-link" href="/PersonalInformation">Personal Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/EmploymentInformation">Employment Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/PayrollInformation">Payroll Information</a></li>
  <li class="nav-item"><a class="nav-link active">Other Information</a></li>
  <li class="nav-item"><a class="nav-link" href="/NextOfKinInformation">Next of Kin Information</a></li>
</ul>

<div class="not-found">
  <div class="not-found-title">Other Information</div>
  <div class="not-found-message">No form for this tab</div>
</div>

<div class="nav-buttons">
  <a href="/PayrollInformation" class="prev">← Previous</a>
  <a href="/NextOfKinInformation" class="next">Next →</a>
</div>

</div></div>

<script>
const O={
 prof:["Basic","Intermediate","Advanced","Fluent"]
};

document.querySelectorAll('select[data-o]').forEach(s=>{
  s.add(new Option('Select',''));
  O[s.dataset.o].forEach(v=>s.add(new Option(v,v)))
});

document.addEventListener('change',e=>{
  const t=e.target;
  if(t.dataset.g&&t.checked)
    document.querySelectorAll('input[data-g="'+t.dataset.g+'"]').forEach(x=>{
      if(x!==t)x.checked=false
    })
});

document.querySelectorAll('input[maxlength="10"]').forEach(t=>t.addEventListener('input',()=>{
 let v=t.value.replace(/\D/g,'').slice(0,8);
 if(v.length>4)v=v.slice(0,2)+'/'+v.slice(2,4)+'/'+v.slice(4);else if(v.length>2)v=v.slice(0,2)+'/'+v.slice(2);
 t.value=v;
}));
</script>
</body>
</html>
